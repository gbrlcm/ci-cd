# ============================================================
# Cidades ESG Inteligentes (InovaGAB) — InovaGAB_API
# Exemplo de variáveis de ambiente. Copie para .env e ajuste.
# NUNCA coloque valores reais de produção neste arquivo no Git.
# ============================================================

# --- Aplicação ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# --- JWT (troque em produção; mínimo 32 caracteres) ---
JWT_SECRET=my-dev-secret-for-jwt-generation-which-should-be-changed-in-production

# --- MongoDB ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=inovagab_db
MONGO_USERNAME=root
MONGO_PASSWORD=secret
MONGO_AUTH_DB=admin

# --- Deploy (preenchido apenas quando houver servidor remoto) ---
SERVER_HOST=
SERVER_USER=
SERVER_SSH_KEY=